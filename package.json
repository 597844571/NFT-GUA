{
  "name": "dc-autobot",
  "version": "1.0.0",
  "description": "数字藏品自动化工具 - DC AutoBot",
  "main": "main.js",
  "author": "DC AutoBot",
  "scripts": {
    "dev": "npm run build:preload && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.config.js",
    "build:electron": "npm run build:preload && electron-builder",
    "preview": "vite preview",
    "postinstall": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.dcautobot.app",
    "productName": "DC AutoBot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "src/main",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
